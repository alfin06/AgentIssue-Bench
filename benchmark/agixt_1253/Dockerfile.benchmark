FROM python:3.10-slim

WORKDIR /app

# Install git and required dependencies with retry logic
RUN set -eux; \
    apt-get update || (sleep 10 && apt-get update) || (sleep 30 && apt-get update); \
    # Try to install the packages with retries
    for i in $(seq 1 3); do \
        apt-get install -y --no-install-recommends \
            git \
            patch \
            && break \
            || { echo "apt-get attempt $i failed, retrying..."; sleep 10; }; \
    done; \
    # Clean up
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# Accept build arguments for commits
ARG BUGGY_COMMIT
ARG FIXED_COMMIT
ENV BUGGY_COMMIT=${BUGGY_COMMIT} FIXED_COMMIT=${FIXED_COMMIT}

# Clone the repository with full history to ensure all commits are available
RUN git clone https://github.com/Josh-XT/AGiXT.git source_code_buggy && \
    cd source_code_buggy && \
    echo "Checking out buggy commit: ${BUGGY_COMMIT}" && \
    git checkout ${BUGGY_COMMIT} && \
    cd /app && \
    cp -r source_code_buggy source_code_fixed && \
    cd source_code_fixed && \
    echo "Checking out fixed commit: ${FIXED_COMMIT}" && \
    git checkout ${FIXED_COMMIT}

# Create test data directories
RUN mkdir -p /app/data/chains /app/data/imported_chains

# Copy test files
COPY reproduce.py /opt/reproduce.py
COPY run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
COPY metadata.json /opt/metadata.json

# Make entrypoint executable
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]
CMD ["help"]