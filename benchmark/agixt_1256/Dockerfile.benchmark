FROM python:3.10-slim

WORKDIR /app

# Install git and required dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    build-essential \
    python3-dev \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Accept build arguments for commits
ARG BUGGY_COMMIT
ARG FIXED_COMMIT
ENV BUGGY_COMMIT=${BUGGY_COMMIT} FIXED_COMMIT=${FIXED_COMMIT}

# Clone the repository without specifying depth to get the full history
RUN git clone https://github.com/Josh-XT/AGiXT.git source_code_buggy && \
    cd source_code_buggy && \
    # Fetch all history and all branches
    git fetch --all && \
    echo "Checking out buggy commit: ${BUGGY_COMMIT}" && \
    git checkout ${BUGGY_COMMIT} && \
    # Install common dependencies that AGiXT needs
    pip install python-dotenv sqlalchemy pydantic fastapi pytest pytest-asyncio \
               requests aiohttp aiofiles tqdm uvicorn pymysql psycopg2-binary && \
    # Install AGiXT dependencies
    pip install -e ".[dev]" || pip install -e . || pip install -r requirements.txt || echo "Failed to install dependencies, will try manually" && \
    cd /app && \
    cp -r source_code_buggy source_code_fixed && \
    cd source_code_fixed && \
    echo "Checking out fixed commit: ${FIXED_COMMIT}" && \
    git checkout ${FIXED_COMMIT}

# Copy test files
COPY repro_script.py /opt/repro_script.py
COPY run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
COPY metadata.json /opt/metadata.json

# Make entrypoint executable
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]
CMD ["help"]