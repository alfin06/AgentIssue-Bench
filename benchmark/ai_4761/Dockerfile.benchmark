FROM node:20-slim

# Install git
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

# Set arguments for commit hashes
ARG BUGGY_COMMIT
ARG FIXED_COMMIT
ENV BUGGY_COMMIT=${BUGGY_COMMIT}
ENV FIXED_COMMIT=${FIXED_COMMIT}

# Clone both versions
WORKDIR /app
RUN git clone https://github.com/vercel/ai.git source_code_buggy && \
    cd source_code_buggy && \
    git checkout ${BUGGY_COMMIT}

RUN git clone https://github.com/vercel/ai.git source_code_fixed && \
    cd source_code_fixed && \
    git checkout ${FIXED_COMMIT}

# Copy test scripts
COPY reproduce.js /opt/reproduce.js
COPY run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
COPY metadata.json /opt/metadata.json
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

# Set up for the test script
WORKDIR /opt
RUN echo '{"type": "module"}' > /opt/package.json
RUN npm install ai zod
# Install @ai-sdk/vue
RUN npm install @vue/reactivity

# Set default working directory
WORKDIR /app/source_code_buggy

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]
CMD ["help"]