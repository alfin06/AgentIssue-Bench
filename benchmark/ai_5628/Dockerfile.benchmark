FROM node:20-slim

# Install git and other dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

# Set build arguments for commit hashes
ARG BUGGY_COMMIT FIXED_COMMIT
ENV BUGGY_COMMIT=${BUGGY_COMMIT} FIXED_COMMIT=${FIXED_COMMIT}

# Clone the repository
WORKDIR /app
RUN git clone https://github.com/vercel/ai.git source_code_buggy && \
    cd source_code_buggy && \
    git checkout ${BUGGY_COMMIT} && \
    git clone https://github.com/vercel/ai.git /app/source_code_fixed && \
    cd /app/source_code_fixed && \
    git checkout ${FIXED_COMMIT}

# Build the buggy version
WORKDIR /app/source_code_buggy
RUN npm install -g pnpm
RUN pnpm install && pnpm build

# Build the fixed version
WORKDIR /app/source_code_fixed
RUN pnpm install && pnpm build

# Setup test environment
WORKDIR /opt
COPY reproduce.js /opt/reproduce.js
COPY run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
COPY metadata.json /opt/metadata.json
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

# Create package.json for ES module support
RUN echo '{"type": "module"}' > /opt/package.json

# Install test dependencies in /opt (including zod-to-json-schema)
WORKDIR /opt
RUN npm install ai zod @ai-sdk/google-vertex@0.0.14 zod-to-json-schema

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]
CMD ["help"]