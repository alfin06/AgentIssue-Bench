# Use a modern, slim Node.js base image
FROM node:20-slim

# --- SETUP SECTION ---
# 1. Install git. Yarn is already included in this base image.
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

# 2. Set arguments that will be passed during the build
ARG BUGGY_COMMIT FIXED_COMMIT
ENV BUGGY_COMMIT=${BUGGY_COMMIT} FIXED_COMMIT=${FIXED_COMMIT}

# 3. Copy the local source code into the container
COPY ./source_code_buggy /app/source_code_buggy

# 4. Set the working directory to the root of the source code
WORKDIR /app/source_code_buggy

# 5. Enable Corepack, which is required to use the modern version of Yarn
RUN corepack enable

# 6. --- DEFINITIVE FIX ---
#    Install all project dependencies AND the test runner (tsx) directly
#    into the project's own node_modules. This resolves all pathing issues.
RUN yarn install
RUN yarn add tsx

# --- TEST SCRIPT SETUP ---
# 7. Copy the test scripts into a separate, fixed location for clarity
COPY repro_script.ts /opt/repro_script.ts
COPY run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

# The working directory remains the source code directory for the entrypoint
WORKDIR /app/source_code_buggy

# Set the entrypoint for the container
ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]
CMD ["help"]
