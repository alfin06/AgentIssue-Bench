# Use a Python base image that matches the version from the bug report
FROM python:3.12-slim

# --- SETUP SECTION ---
# 1. Install git, which is required by the entrypoint script to checkout commits.
RUN apt-get update && apt-get install -y --no-install-recommends git build-essential && rm -rf /var/lib/apt/lists/*

# 2. Set arguments that will be passed during the build.
ARG BUGGY_COMMIT FIXED_COMMIT
ENV BUGGY_COMMIT=${BUGGY_COMMIT} \
    FIXED_COMMIT=${FIXED_COMMIT} \
    REPO_URL=https://github.com/crewAIInc/crewAI.git

# --- SOURCE CODE SETUP ---
# 3. Clone the repository once for the buggy version.
RUN git clone "${REPO_URL}" /app/source_code_buggy
WORKDIR /app/source_code_buggy
RUN git checkout "${BUGGY_COMMIT}"

# 4. Make a local copy for the fixed version (this is much faster than cloning again).
RUN cp -a /app/source_code_buggy /app/source_code_fixed
WORKDIR /app/source_code_fixed
RUN git checkout "${FIXED_COMMIT}"

# --- INSTALLATION SECTION ---
# 5. Install the dependencies for both versions to ensure the environment is ready.
WORKDIR /app/source_code_buggy
RUN pip install -e .

WORKDIR /app/source_code_fixed
RUN pip install -e .

# 6. Install the specific external libraries required by the test script.
RUN pip install --no-cache-dir python-dotenv langchain-openai embedchain

# --- TEST SCRIPT SETUP ---
# 7. Copy the test scripts into the container.
COPY reproduce.py /opt/reproduce.py
COPY run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

# Set the entrypoint for the container.
ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]
CMD ["help"]