FROM python:3.12-slim

RUN for i in 1 2 3 4 5; do \
      apt-get update && \
      apt-get install -y --no-install-recommends git build-essential --fix-missing && \
      rm -rf /var/lib/apt/lists/* && break || sleep 5; \
   done

ARG REPO_URL=https://github.com/crewAIInc/crewAI.git
ARG BUGGY_COMMIT
ARG FIXED_COMMIT

WORKDIR /app/source_code
RUN git clone ${REPO_URL} . 

COPY reproduce.py /opt/reproduce.py
COPY run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
COPY metadata.json /opt/metadata.json
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]
CMD ["help"]