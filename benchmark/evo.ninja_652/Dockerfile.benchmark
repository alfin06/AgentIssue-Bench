# Use the official Playwright base image to ensure all browser dependencies are present.
FROM mcr.microsoft.com/playwright:v1.45.0-jammy

# Install git and build-essential for native Node modules.
RUN apt-get update && \
    SUCCESS=false && \
    for i in 1 2 3; do \
        if apt-get install -y --no-install-recommends git build-essential python3; then \
            SUCCESS=true; \
            break; \
        fi; \
        echo "apt-get install failed. Retrying in 5 seconds..." >&2; \
        sleep 5; \
    done; \
    if [ "$SUCCESS" = "false" ]; then \
        echo "Failed to install packages after multiple retries." >&2; \
        exit 1; \
    fi && \
    rm -rf /var/lib/apt/lists/*

# Set arguments for commit hashes.
ARG BUGGY_COMMIT
ARG FIXED_COMMIT
ENV BUGGY_COMMIT=${BUGGY_COMMIT}
ENV FIXED_COMMIT=${FIXED_COMMIT}

# Clone the buggy version.
WORKDIR /app/source_code_buggy
COPY /source_code_buggy /app/source_code_buggy

# Clone the fixed version.
WORKDIR /app/source_code_fixed
COPY /source_code_fixed /app/source_code_fixed

WORKDIR /app/source_code_buggy
RUN rm -f yarn.lock
RUN npm install -g pnpm@9.1.1
RUN SUCCESS=false && \
    for i in 1 2 3; do \
        if pnpm install --shamefully-hoist; then \
            SUCCESS=true; \
            break; \
        fi; \
        echo "pnpm install failed. Retrying in 5 seconds..." >&2; \
        sleep 5; \
    done; \
    if [ "$SUCCESS" = "false" ]; then \
        echo "Failed to install pnpm dependencies after multiple retries." >&2; \
        exit 1; \
    fi

# Install Playwright browsers.
RUN npx playwright install --with-deps

# Copy test scripts and metadata.
COPY reproduce.ts /opt/reproduce.ts
COPY run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
COPY metadata.json /opt/metadata.json
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

# Set the default working directory.
WORKDIR /app/source_code_buggy

# Set the entrypoint.
ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]
CMD ["help"]