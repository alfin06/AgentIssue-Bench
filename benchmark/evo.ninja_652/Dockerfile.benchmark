FROM node:20-slim

# Install git and required packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git && \
    rm -rf /var/lib/apt/lists/*

# Set arguments for commit hashes
ARG BUGGY_COMMIT
ARG FIXED_COMMIT
ARG GITHUB_TOKEN
ENV BUGGY_COMMIT=${BUGGY_COMMIT}
ENV FIXED_COMMIT=${FIXED_COMMIT}

# Clone both versions
WORKDIR /app
RUN git clone https://${GITHUB_TOKEN}@github.com/agentcoinorg/evo.ninja.git source_code_buggy && \
    cd source_code_buggy && \
    git checkout ${BUGGY_COMMIT}

RUN git clone https://${GITHUB_TOKEN}@github.com/agentcoinorg/evo.ninja.git source_code_fixed && \
    cd source_code_fixed && \
    git checkout ${FIXED_COMMIT}

# No need for npm install since we're just checking source code

# Copy test scripts
WORKDIR /app
COPY reproduce.js /opt/reproduce.js
COPY run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
COPY metadata.json /opt/metadata.json
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

# Set the default working directory
WORKDIR /app/source_code_buggy

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]
CMD ["help"]