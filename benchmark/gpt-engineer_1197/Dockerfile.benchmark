FROM python:3.11-slim

# Install git and other dependencies
RUN apt-get update && \
    apt-get install -y git patch && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Create directories for source code
RUN mkdir -p /app/source_code_buggy /app/source_code_fixed /app/test_project

# Set environment variables
# Use a simpler form to avoid the $PYTHONPATH warning
ENV PYTHONPATH=/app/source_code_buggy:/app/source_code_fixed
ARG BUGGY_COMMIT=c1f4a9da5dd0abed15b91f6d1c60464cad84ce6c
ARG FIXED_COMMIT=3ca14356a89aef9bf7b1151eafe40124c5e42542
ENV BUGGY_COMMIT=${BUGGY_COMMIT}
ENV FIXED_COMMIT=${FIXED_COMMIT}

# Clone the repository for both buggy and fixed versions
RUN git clone https://github.com/gpt-engineer-org/gpt-engineer.git /app/source_code_buggy && \
    cd /app/source_code_buggy && \
    git checkout ${BUGGY_COMMIT} && \
    git clone https://github.com/gpt-engineer-org/gpt-engineer.git /app/source_code_fixed && \
    cd /app/source_code_fixed && \
    git checkout ${FIXED_COMMIT}

# Install test dependencies
RUN pip install pytest mock pytest-mock

# Copy test files
COPY reproduce.py /opt/reproduce.py
COPY run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
COPY metadata.json /opt/metadata.json
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]

# Default command
CMD ["help"]