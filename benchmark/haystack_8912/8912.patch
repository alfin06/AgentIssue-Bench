@@ -373,16 +373,13 @@ def _prepare_api_call(  # noqa: PLR0913
 
         openai_tools = {}
         if tools:
-            tool_definitions = [
-                {
-                    "type": "function",
-                    "function": {
-                        **t.tool_spec,
-                        **({"strict": tools_strict, "additionalProperties": False} if tools_strict else {}),
-                    },
