# Use a standard Node.js 20 base image, as specified in the bug report
FROM node:20-slim

# Install git, which is required by the entrypoint script to checkout different commits
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    SUCCESS=false && \
    for i in 1 2 3; do \
        if apt-get install -y --no-install-recommends git; then \
            SUCCESS=true; \
            break; \
        fi; \
        echo "apt-get install failed. Retrying in 5 seconds..." >&2; \
        sleep 5; \
    done; \
    if [ "$SUCCESS" = "false" ]; then \
        echo "Failed to install packages after multiple retries." >&2; \
        exit 1; \
    fi && \
    rm -rf /var/lib/apt/lists/*

# Arguments that will be passed during the 'docker build' command
ARG BUGGY_COMMIT
ARG FIXED_COMMIT

# Set them as environment variables to be accessible by the entrypoint script
ENV BUGGY_COMMIT=${BUGGY_COMMIT}
ENV FIXED_COMMIT=${FIXED_COMMIT}

# Create a directory for the test setup
WORKDIR /opt/test-env

# Copy test configuration, test script, and the entrypoint script
COPY ./package.json ./package-lock.json* ./
COPY ./jest.config.js ./
COPY ./reproduce.ts ./
COPY ./metadata.json ./
COPY ./run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

# Install the specific versions of packages needed for the test
RUN npm install

# Clone the repository for both buggy and fixed versions
WORKDIR /app
RUN git clone https://github.com/langchain-ai/langgraphjs.git /app/source_code_buggy

# --- Build Step ---
# Set the working directory to the cloned repository
WORKDIR /app/source_code_buggy

# This project uses yarn. Install dependencies using yarn.
RUN yarn install

# Build the entire project to ensure all internal dependencies are resolved.
RUN yarn build

# Set the entrypoint to our custom script
ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]

# Default command to run if none is provided is 'help'
CMD ["help"]