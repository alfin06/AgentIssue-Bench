# Use a modern, slim Node.js LTS base image
FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm

ARG BUGGY_COMMIT FIXED_COMMIT
ENV BUGGY_COMMIT=${BUGGY_COMMIT} FIXED_COMMIT=${FIXED_COMMIT}

RUN git clone https://github.com/mastra-ai/mastra.git /app/source_code

WORKDIR /app/source_code

RUN git checkout ${BUGGY_COMMIT}

RUN pnpm install
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN pnpm build

COPY reproduce.js /opt/reproduce.js
COPY run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

WORKDIR /opt

RUN echo '{"type": "module"}' > /opt/package.json

RUN npm install /app/source_code/packages/core /app/source_code/packages/memory

ENV NODE_OPTIONS=""
ENV NODE_PATH="/opt/node_modules"

WORKDIR /app/source_code

ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]
CMD ["help"]