From 2e5a710247489eb31aad0a8233ec97fc343c6bec Mon Sep 17 00:00:00 2001
From: jason <jasonxie_rd@163.com>
Date: Mon, 9 Sep 2024 19:06:22 +0800
Subject: [PATCH] fix ollama output without json format

---
 mle/model.py | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/mle/model.py b/mle/model.py
index f466acf..2f75e94 100644
--- a/mle/model.py
+++ b/mle/model.py
@@ -56,7 +56,13 @@ def query(self, chat_history, **kwargs):
         Args:
             chat_history: The context (chat history).
         """
-        return self.client.chat(model=self.model, messages=chat_history)['message']['content']
+
+        # Check if 'response_format' exists in kwargs
+        format = None
+        if 'response_format' in kwargs and kwargs['response_format'].get('type') == 'json_object':
+            format = 'json'
+
+        return self.client.chat(model=self.model, messages=chat_history, format=format)['message']['content']
 
     def stream(self, chat_history, **kwargs):
         """