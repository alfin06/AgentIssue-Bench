# Benchmark Dockerfile for issue: https://github.com/MLSysOps/MLE-agent/issues/173
#
# This Dockerfile creates a reproducible Python environment to test the bug.

# Use a Python 3.11 base image as specified in the bug report's stack trace
FROM python:3.11-slim

# Install git, which is required by the entrypoint script to checkout different commits
RUN apt-get update && apt-get install -y git --no-install-recommends && rm -rf /var/lib/apt/lists/*

# Arguments that will be passed during the 'docker build' command
ARG BUGGY_COMMIT
ARG FIXED_COMMIT

# Set them as environment variables to be accessible by the entrypoint script
ENV BUGGY_COMMIT=${BUGGY_COMMIT}
ENV FIXED_COMMIT=${FIXED_COMMIT}

# Set the main working directory for the project
WORKDIR /app

# Copy the local source code repository into the image's working directory.
COPY ./source_code_buggy .

# Copy the failure-triggering test script and the entrypoint script into the image
COPY ./repro_script.py /opt/repro_script.py
COPY ./run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

# Install the project dependencies using pip and the requirements.txt file.
RUN pip install -r requirements.txt

# This is a key step: Install the MLE-agent package itself from the source code.
# This makes it available as a standard library for the test script to import.
RUN pip install .

# Set the entrypoint to our custom script
ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]

# Default command to run if none is provided is 'help'
CMD ["help"]
