FROM node:18-slim

# Install git and required dependencies
RUN apt-get update && \
    apt-get install -y git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Create directories for source code
RUN mkdir -p /app/source_code_buggy /app/source_code_fixed

# Set environment variables
ARG BUGGY_COMMIT
ARG FIXED_COMMIT
ENV BUGGY_COMMIT=${BUGGY_COMMIT}
ENV FIXED_COMMIT=${FIXED_COMMIT}

# Clone the repository for both buggy and fixed versions
RUN git clone https://github.com/Pythagora-io/pythagora.git /app/source_code_buggy && \
    cd /app/source_code_buggy && \
    git checkout ${BUGGY_COMMIT} && \
    git clone https://github.com/Pythagora-io/pythagora.git /app/source_code_fixed && \
    cd /app/source_code_fixed && \
    git checkout ${FIXED_COMMIT}

# Install dependencies for both versions
RUN cd /app/source_code_buggy && npm install && \
    cd /app/source_code_fixed && npm install

# Create a test project directory
RUN mkdir -p /app/test_project

# Copy test files
COPY reproduce.js /opt/reproduce.js
COPY run_test_entrypoint.sh /opt/run_test_entrypoint.sh
COPY metadata.json /opt/metadata.json

# Make the entry point script executable
RUN chmod +x /opt/run_test_entrypoint.sh

# Set the entrypoint
ENTRYPOINT ["/opt/run_test_entrypoint.sh"]

# Default command
CMD ["help"]