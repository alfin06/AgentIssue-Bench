FROM node:18-bullseye-slim

# Install git, python3 and other dependencies
RUN apt-get update && \
    apt-get install -y git curl jq python3 python3-pip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Create directories for source code
RUN mkdir -p /app/source_code_buggy /app/source_code_fixed

# Set environment variables
ARG BUGGY_COMMIT
ARG FIXED_COMMIT
ENV BUGGY_COMMIT=${BUGGY_COMMIT}
ENV FIXED_COMMIT=${FIXED_COMMIT}

# Clone the repository for both buggy and fixed versions
RUN git clone https://github.com/superagent-ai/superagent.git /app/source_code_buggy && \
    cd /app/source_code_buggy && \
    git checkout ${BUGGY_COMMIT} && \
    git clone https://github.com/superagent-ai/superagent.git /app/source_code_fixed && \
    cd /app/source_code_fixed && \
    git checkout ${FIXED_COMMIT}

# Copy test files
COPY reproduce.py /opt/reproduce.py
COPY run_test_entrypoint.sh /opt/run_test_entrypoint.sh
COPY metadata.json /opt/metadata.json

# Make the entry point script executable
RUN chmod +x /opt/run_test_entrypoint.sh

# Set the entrypoint
ENTRYPOINT ["/opt/run_test_entrypoint.sh"]

# Default command
CMD ["help"]