FROM node:18-slim

WORKDIR /app

# Retry apt-get update/install up to 5 times if it fails, and use --fix-missing
RUN set -eux; \
    for i in 1 2 3 4 5; do \
        apt-get update && \
        apt-get install -y --no-install-recommends --fix-missing git ca-certificates python3 python3-pip libssh2-1 && \
        apt-get clean && \
        rm -rf /var/lib/apt/lists/* && \
        break || { echo "apt-get failed, retrying ($i/5)..."; sleep 5; }; \
    done

ARG BUGGY_COMMIT
ARG FIXED_COMMIT
ENV BUGGY_COMMIT=${BUGGY_COMMIT} FIXED_COMMIT=${FIXED_COMMIT}

RUN git clone https://github.com/SWE-agent/SWE-agent.git /app/source_code_buggy && \
    cd /app/source_code_buggy && \
    git -c advice.detachedHead=false checkout ${BUGGY_COMMIT} --force

RUN git clone https://github.com/SWE-agent/SWE-agent.git /app/source_code_fixed && \
    cd /app/source_code_fixed && \
    git -c advice.detachedHead=false checkout ${FIXED_COMMIT} --force

COPY reproduce.py /opt/reproduce.py
COPY run_test_entrypoint.sh /usr/local/bin/run_test_entrypoint.sh
RUN chmod +x /usr/local/bin/run_test_entrypoint.sh

ENTRYPOINT ["/usr/local/bin/run_test_entrypoint.sh"]
CMD ["help"]